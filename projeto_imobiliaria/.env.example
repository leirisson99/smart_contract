# Polygon Amoy testnet (ADR-0002) — RPC endpoint used by `forge script --rpc-url amoy`
# Get a free endpoint from a provider (Alchemy, Infura, etc.) or use the public RPC.
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology

# Deploy account private key (testnet only — never commit a real key).
# Fund this address with test MATIC via the Polygon Amoy faucet before deploying.
PRIVATE_KEY=0x

# Optional: Polygonscan API key, used for `forge verify-contract` on Amoy.
POLYGONSCAN_API_KEY=
