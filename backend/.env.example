# Postgres local (usado junto com docker-compose.yml deste diretorio)
DATABASE_URL="postgresql://kyc:kyc@localhost:5432/kyc?schema=public"

# RPC da chain onde o IdentityRegistry esta deployado (Anvil local por padrao)
RPC_URL="http://127.0.0.1:8545"
CHAIN_ID="31337"

# Enderecos deployados (ver projeto_imobiliaria/broadcast/DeployIdentityKyc.s.sol/31337/run-latest.json)
IDENTITY_REGISTRY_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"

# Marketplace (feature 004-mercado-secundario), compartilhado entre todos os
# imoveis (ver projeto_imobiliaria/broadcast/DeployMarketplace.s.sol/31337/run-latest.json).
# Depois do deploy, rode `npm run grant-marketplace-kyc` para que o proprio
# contrato consiga manter cotas em escrow (ver Marketplace.sol).
MARKETPLACE_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"

# Chave privada do Trusted Issuer que o backend usa para chamar emitirClaim.
# POC/dev apenas: em producao isso deve vir de um KMS/HSM, nunca de .env versionado.
TRUSTED_ISSUER_PRIVATE_KEY="0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d"

# Chave de uma conta propria do backend usada so para financiar (com ETH de
# gas) as carteiras custodiais recem-criadas, que nascem sem saldo - sem isso
# o investidor nao consegue assinar nem uma transacao propria (comprarCotas,
# claim). Conta de teste padrao do Anvil (#2), so para dev/POC.
GAS_SPONSOR_PRIVATE_KEY="0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a"

# Chave usada para "criptografar" dados sensiveis (CPF, chave privada da wallet custodial) em dev.
# Placeholder de custodia real (HSM/KMS) — task 1 do backend, fora do escopo desta feature.
WALLET_ENC_KEY="dev-only-change-me-0123456789ab"

PORT="3000"
