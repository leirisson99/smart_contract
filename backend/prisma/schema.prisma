generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Investor {
  id            String         @id @default(uuid())
  fullName      String
  cpfEncrypted  String
  walletAddress String         @unique
  walletKeyEnc  String
  createdAt     DateTime       @default(now())
  kyc           KycSubmission?
  investments   Investment[]
  yieldClaims   YieldClaim[]
}

model KycSubmission {
  id                String   @id @default(uuid())
  investorId        String   @unique
  investor          Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  status            String   @default("PENDING")
  provider          String
  providerReference String?
  rejectionReason   String?
  claimTxHash       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Metadados off-chain de um imovel (feature 002/005) - dados financeiros
/// (precoPorCota, totalCotas, cotasDisponiveis) NAO sao duplicados aqui:
/// sao lidos ao vivo do PropertyToken on-chain a cada request, para nunca
/// divergir da fonte da verdade (o contrato). Aqui fica so o que o contrato
/// nao guarda (imagem, status de UX, rendimento estimado, valor minimo).
model Property {
  id                           String       @id @default(uuid())
  propertyTokenAddress         String       @unique
  dividendDistributorAddress   String      @unique
  imagemUrl                    String?
  rendimentoEstimadoAnual      Float
  status                       String       @default("EM_CAPTACAO")
  valorMinimoInvestimento      String
  /// CAS de exclusao mutua do POST /admin/imoveis/:id/depositar-rendimento:
  /// setado para `now()` (via `updateMany` condicional) antes de acionar
  /// DividendDistributor.depositarRendimento e liberado (`null`) no
  /// `finally`, para que um duplo-clique/retry concorrente do gestor receba
  /// 409 em vez de criar um segundo ciclo real on-chain. Uma trava mais
  /// antiga que o TTL (rota) e tratada como presa (processo derrubado no
  /// meio) e pode ser retomada.
  rendimentoDepositoTravadoEm  DateTime?
  createdAt                    DateTime     @default(now())
  investments                  Investment[]
  yieldClaims                  YieldClaim[]
}

/// Rastreio de cada chamada a POST /admin/imoveis (RF-25): criarImovelOnChain
/// executa 3 transacoes on-chain sequenciais (deploy do PropertyToken via
/// PropertyFactory, deploy do DividendDistributor, grantRole do
/// SNAPSHOT_ROLE) e so entao a linha em `Property` e criada. Sem rollback
/// possivel em blockchain, esta tabela existe para que uma falha na 2a/3a
/// transacao nunca deixe contratos deployados on-chain sem nenhum rastro no
/// banco - a tentativa fica gravada (com os enderecos ja obtidos) para
/// reconciliacao manual por um gestor, em vez de ser descartada em memoria.
model PropertyCreationAttempt {
  id                          String   @id @default(uuid())
  nome                        String
  valorTotal                  String
  totalCotas                  Int
  rendimentoEstimadoAnual     Float
  imagemUrl                   String?
  status                      String   @default("PENDING")
  propertyTokenAddress        String?
  dividendDistributorAddress  String?
  txHashCriacao                String?
  txHashDistributor            String?
  erro                        String?
  propertyId                  String?
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

/// Ledger de aquisicoes de cotas, tanto primarias (RF-22, `PropertyToken.comprarCotas`)
/// quanto secundarias (RF-35, `Marketplace.comprar`). cotas/valorPago sao o
/// registro do que foi de fato executado on-chain - usado para saber quais
/// imoveis consultar e para calcular "valor investido" no portfolio (003) e
/// para identificar investidores elegiveis no job de claim (003), nenhum dos
/// dois rastreados pelo contrato.
model Investment {
  id         String   @id @default(uuid())
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  cotas      Int
  valorPago  String
  txHash     String
  createdAt  DateTime @default(now())
}

/// Registro de cada claim de rendimento executado pelo job automatico
/// (RF-24). A constraint unica (investor+property+ciclo) garante, junto com
/// `jaReivindicou` on-chain, que o job nunca conta o mesmo ciclo duas vezes
/// mesmo se rodar concorrentemente ou for reexecutado apos falha parcial.
model YieldClaim {
  id         String   @id @default(uuid())
  investorId String
  investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  cicloId    Int
  valor      String
  txHash     String
  claimedAt  DateTime @default(now())

  @@unique([investorId, propertyId, cicloId])
}
